# Intelligent Network Configuration Assistant v2 (INA v2) - environment settings
#
# Copy to .env (same directory) and fill in. The assistant loads .env on start;
# variables already exported in your shell take precedence over this file.
# NEVER commit .env: it holds API keys and role tokens (.gitignore excludes it).

# =============================================================================
# LLM (operator laptop) - any provider
# =============================================================================
# The LLM chooses the MCP tool (native function calling against the server's
# tools/list) and writes the reply from the structured result. Without an LLM
# (LLM_PROVIDER=none, or a missing key) the built-in rule-based parser is used.
#
# LLM_PROVIDER     LLM_BASE_URL preset                                    LLM_MODEL example
# anthropic        (Claude API, official SDK: pip install anthropic)      claude-opus-5-5 (default)
# openrouter       https://openrouter.ai/api/v1                           anthropic/claude-sonnet-4.6, google/..., openai/...
# gemini           https://generativelanguage.googleapis.com/v1beta/openai  gemini-3.8-flash
# openai           https://api.openai.com/v1                              (your OpenAI model)
# groq             https://api.groq.com/openai/v1                         (a Groq model)
# ollama           http://localhost:11434/v1  (no key needed)             (a local model, e.g. one you pulled)
# openai-compatible  set LLM_BASE_URL yourself (LM Studio, vLLM, ...)      (that server's model)
LLM_PROVIDER=none

# API key of the provider above (sent only to that provider).
# anthropic: may be left empty to use ANTHROPIC_API_KEY or an `ant auth login` profile.
LLM_API_KEY=

# Model ID. Required for every provider except anthropic.
LLM_MODEL=

# Override the endpoint (required for openai-compatible; optional otherwise).
LLM_BASE_URL=

# anthropic only: effort level (low | medium | high | xhigh | max; empty = not sent),
# and server-side refusal fallbacks (default | off).
LLM_EFFORT=low
LLM_FALLBACKS=default

# Seconds per LLM request.
LLM_TIMEOUT=30

# =============================================================================
# MCP connection (operator laptop -> Raspberry Pi)
# =============================================================================
# Used by: python -m assistant --server mcp
INA_MCP_URL=https://192.168.50.1:8443/mcp
# The Pi's TLS certificate (copy of /etc/ina/tls/server.crt) to trust.
INA_MCP_CA=
# Your personal role token, from the admin's 'sudo ina-netctl roles grant ...'.
# It works only from the device the role is bound to (fixed IP in devices.yaml).
INA_ROLE_TOKEN=
# NetworkManager connection of the router's Wi-Fi. If the Pi is unreachable and the
# laptop is on another network (it fell back while the Pi rebooted), the assistant
# reconnects to this once and retries. Empty = never touch the Wi-Fi.
INA_WIFI_CONNECTION=INA-Router

# =============================================================================
# Local development only (never on the Pi)
# =============================================================================
# Accept the built-in demo tokens (operator-token, admin-token, viewer-token).
# INA_DEMO_TOKENS=1
# Run ina-netctl without sudo when testing the MCP server on a laptop.
# INA_NETCTL_COMMAND=python3 -m inav2.network.netctl

# =============================================================================
# Raspberry Pi 5 router reference values (documentation; read by docs/tools)
# =============================================================================
ROUTER_HOST=ina-router
ROUTER_IP=192.168.50.1
AP_INTERFACE=ap0
UPLINK_INTERFACE=wlan0
MANAGED_SUBNET=192.168.50.0/24
