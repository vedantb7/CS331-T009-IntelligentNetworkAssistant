# Intelligent Network Configuration Assistant v2 (INA v2) Environment Configuration
# Copy this file to .env and replace placeholder values with your local settings.
# NEVER commit real credentials or secrets to version control.

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# Assistant / LLM Provider Settings
LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-2.0-flash

# FastMCP Server Settings
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000

# Managed Network Interface Settings
NETWORK_INTERFACE=wlan0
MANAGED_SUBNET=192.168.10.0/24

