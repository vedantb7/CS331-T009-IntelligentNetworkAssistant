#!/bin/sh
# /usr/local/sbin/ina-netctl -- root entry point of the INA privilege boundary.
#
# Install: root:root, mode 0755. /etc/sudoers.d/ina lets the unprivileged 'ina'
# user run exactly this file (and nothing else) as root. Everything INA does
# with privileges - nft, tc, hostapd_cli, /var/lib/ina, /var/log/ina, /run/ina -
# happens below this line.
#
# The code (/opt/ina) and the virtualenv must be root-owned and NOT writable by
# 'ina'; otherwise 'ina' could change what runs as root. Python runs isolated
# (-I): PYTHONPATH, user site-packages and the current directory are ignored.
set -eu

INA_HOME=/opt/ina

exec "$INA_HOME/venv/bin/python" -I -c '
import sys
sys.path.insert(0, "/opt/ina")
from inav2.network.netctl import main
sys.exit(main())
' "$@"
