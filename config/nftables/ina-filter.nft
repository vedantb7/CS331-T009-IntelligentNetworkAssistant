#!/usr/sbin/nft -f
# /etc/nftables.d/ina-filter.nft -- owned by INA; coexists with "table ip ina_nat".
# Loaded at boot by /etc/nftables.conf (include "/etc/nftables.d/ina-filter.nft").
# Never use "flush ruleset"; only this table is (re)created.
#
# The two lines below make a reload replace the table cleanly (no duplicated
# rules). That also empties the sets; ina-reconcile.service (PartOf=nftables)
# re-applies blocks and bans from /var/lib/ina/state.json afterwards.
# network/access_control.py loads this file without them when only the chains
# are missing, so existing set elements are kept.
table inet ina_filter
delete table inet ina_filter
table inet ina_filter {
	# Authorised (MAC, IPv4) bindings, filled by 'ina-netctl sync-devices' from policy/devices.yaml.
	set mac_ip_bind {
		type ether_addr . ipv4_addr
	}
	# IPv4 addresses that are bound (anti-spoofing applies only to these).
	set managed_ips {
		type ipv4_addr
	}
	# Pairwise blocks: INA always inserts both directions (A . B and B . A).
	set blocked_pairs {
		type ipv4_addr . ipv4_addr
	}
	set blocked_internet {
		type ipv4_addr
	}
	set blocked_gateway {
		type ipv4_addr
	}
	# Scope "all": no client<->client, no Internet, no Pi services except DHCP/DNS.
	set isolated {
		type ipv4_addr
	}

	chain prerouting {
		type filter hook prerouting priority raw; policy accept;
		# Anti-spoofing: a managed IPv4 source must arrive with its bound MAC.
		iifname "ap0" ip saddr @managed_ips ether saddr . ip saddr != @mac_ip_bind counter drop
	}

	chain forward {
		type filter hook forward priority filter; policy accept;
		# No "ct state established accept" before these rules: existing flows are cut too.
		iifname "ap0" oifname "ap0" ip saddr . ip daddr @blocked_pairs counter reject with icmpx admin-prohibited
		iifname "ap0" oifname "ap0" ip saddr @isolated counter reject with icmpx admin-prohibited
		iifname "ap0" oifname "ap0" ip daddr @isolated counter reject with icmpx admin-prohibited
		iifname "ap0" oifname "wlan0" ip saddr @blocked_internet counter reject with icmpx admin-prohibited
		iifname "ap0" oifname "wlan0" ip saddr @isolated counter reject with icmpx admin-prohibited
		iifname "wlan0" oifname "ap0" ip daddr @blocked_internet counter drop
		iifname "wlan0" oifname "ap0" ip daddr @isolated counter drop
		# IPv6 is not routed on the client LAN.
		iifname "ap0" meta nfproto ipv6 counter drop
	}

	chain input {
		type filter hook input priority filter; policy accept;
		# DHCP and DNS stay reachable for blocked/isolated clients, so they stay "on the network".
		iifname "ap0" udp dport { 53, 67 } accept
		iifname "ap0" tcp dport 53 accept
		iifname "ap0" ip saddr @blocked_gateway counter reject with icmpx admin-prohibited
		iifname "ap0" ip saddr @isolated counter reject with icmpx admin-prohibited
	}
}
